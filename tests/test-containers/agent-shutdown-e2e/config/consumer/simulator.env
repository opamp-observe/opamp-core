# Simulator shutdown regression configuration.
DEPLOYMENT_TYPE=simulator
AGENT_VERSION=0.4.1
WHEEL_PATH=/host-assets/dist/consumer
CONSUMER_CONFIG_PATH=/scenario-config/opamp-consumer.json
SIMULATOR_RESPONSES_PATH=/scenario-config/simulator-responses.json
CONSUMER_TRANSPORT=http
SERVER_URL=http://provider:8080
AGENT_ONLY=false
SMOKE_ONLY=false
SKIP_AGENT_INSTALL=true
APP_ENABLE_DEV_FEATURES=true
HOSTNAME_OVERRIDE=shutdown-e2e-simulator
SERVICE_NAME_OVERRIDE=Simulator
SERVICE_NAMESPACE_OVERRIDE=AgentShutdownE2E
SERVICE_INSTANCE_ID_OVERRIDE=shutdown-e2e-simulator
OUTPUT_HOST_DIR=/evidence
