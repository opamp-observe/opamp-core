# Fluentd supervisor shutdown regression configuration.
DEPLOYMENT_TYPE=fluentd
AGENT_VERSION=1.19.0
WHEEL_PATH=/host-assets/dist/consumer
CONSUMER_CONFIG_PATH=/scenario-config/opamp-consumer.json
CONSUMER_TRANSPORT=http
SERVER_URL=http://provider:8080
AGENT_ONLY=false
SMOKE_ONLY=false
SKIP_AGENT_INSTALL=false
HOSTNAME_OVERRIDE=shutdown-e2e-fluentd
SERVICE_NAME_OVERRIDE=Fluentd
SERVICE_NAMESPACE_OVERRIDE=AgentShutdownE2E
SERVICE_INSTANCE_ID_OVERRIDE=shutdown-e2e-fluentd
OUTPUT_HOST_DIR=/evidence
