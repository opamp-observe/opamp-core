# Elastic Agent supervisor shutdown regression configuration.
DEPLOYMENT_TYPE=elastic_agent
AGENT_VERSION=9.3.3
WHEEL_PATH=/host-assets/dist/consumer
CONSUMER_CONFIG_PATH=/scenario-config/opamp-consumer.json
AGENT_CONFIG_PATH=/scenario-config/elastic-agent.yml
CONSUMER_TRANSPORT=http
SERVER_URL=http://provider:8080
AGENT_ONLY=false
SMOKE_ONLY=false
SKIP_AGENT_INSTALL=true
HOSTNAME_OVERRIDE=shutdown-e2e-elastic-agent
SERVICE_NAME_OVERRIDE=ElasticAgent
SERVICE_NAMESPACE_OVERRIDE=AgentShutdownE2E
SERVICE_INSTANCE_ID_OVERRIDE=shutdown-e2e-elastic-agent
OUTPUT_HOST_DIR=/evidence
