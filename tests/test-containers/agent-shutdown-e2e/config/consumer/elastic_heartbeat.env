# Elastic Heartbeat supervisor shutdown regression configuration.
DEPLOYMENT_TYPE=elastic_heartbeat
AGENT_VERSION=9.3.3
WHEEL_PATH=/host-assets/dist/consumer
CONSUMER_CONFIG_PATH=/scenario-config/opamp-consumer.json
AGENT_CONFIG_PATH=/scenario-config/heartbeat.yml
CONSUMER_TRANSPORT=http
SERVER_URL=http://provider:8080
AGENT_ONLY=false
SMOKE_ONLY=false
SKIP_AGENT_INSTALL=false
HOSTNAME_OVERRIDE=shutdown-e2e-elastic-heartbeat
SERVICE_NAME_OVERRIDE=ElasticHeartbeat
SERVICE_NAMESPACE_OVERRIDE=AgentShutdownE2E
SERVICE_INSTANCE_ID_OVERRIDE=shutdown-e2e-elastic-heartbeat
OUTPUT_HOST_DIR=/evidence
