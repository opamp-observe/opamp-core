# Fluent Bit supervisor shutdown regression configuration.
DEPLOYMENT_TYPE=fluentbit
AGENT_VERSION=5.0.3
WHEEL_PATH=/host-assets/dist/consumer
CONSUMER_CONFIG_PATH=/scenario-config/opamp-consumer.json
CONSUMER_TRANSPORT=http
SERVER_URL=http://provider:8080
AGENT_ONLY=false
SMOKE_ONLY=false
SKIP_AGENT_INSTALL=true
HOSTNAME_OVERRIDE=shutdown-e2e-fluentbit
SERVICE_NAME_OVERRIDE=Fluentbit
SERVICE_NAMESPACE_OVERRIDE=AgentShutdownE2E
SERVICE_INSTANCE_ID_OVERRIDE=shutdown-e2e-fluentbit
OUTPUT_HOST_DIR=/evidence
