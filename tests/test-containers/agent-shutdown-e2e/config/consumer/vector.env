# Vector supervisor shutdown regression configuration.
DEPLOYMENT_TYPE=vector
AGENT_VERSION=0.58.0
WHEEL_PATH=/host-assets/dist/consumer
CONSUMER_CONFIG_PATH=/scenario-config/opamp-consumer.json
CONSUMER_TRANSPORT=http
SERVER_URL=http://provider:8080
AGENT_ONLY=false
SMOKE_ONLY=false
SKIP_AGENT_INSTALL=true
HOSTNAME_OVERRIDE=shutdown-e2e-vector
SERVICE_NAME_OVERRIDE=Vector
SERVICE_NAMESPACE_OVERRIDE=AgentShutdownE2E
SERVICE_INSTANCE_ID_OVERRIDE=shutdown-e2e-vector
OUTPUT_HOST_DIR=/evidence
