{
  "consumer": {
    "server_url": "http://127.0.0.1:8080",
    "client_status_port": 6791,
    "chat_ops_port": 8891,
    "transport": "http",
    "processTracking": "Observer",
    "processDetectionRegex": "elastic-agent(\\.exe)?",
    "tls": {
      "verify_server": false,
      "enabled": false
    },
    "server-authorization": "none",
    "log_agent_api_responses": false,
    "agent_config_path": "docs/full-demo/active/elastic-agent.yml",
    "agent_additional_params": [],
    "heartbeat_frequency": 5,
    "service_type": "elastic_agent",
    "full_update_controller": {
      "fullResendAfter": 1
    },
    "full_update_controller_type": "SentCount",
    "allow_custom_capabilities": true,
    "log_level": "debug",
    "service_name": "FullDemoElasticAgent",
    "service_namespace": "FullDemo",
    "agent_capabilities": [
      "AcceptsRemoteConfig",
      "ReportsEffectiveConfig",
      "ReportsHeartbeat"
    ],
    "elastic_agent": {
      "executable_path": "elastic-agent",
      "api_host": "127.0.0.1",
      "api_port": 6791,
      "api_failon": "degraded",
      "status_timeout_seconds": 5
    }
  }
}
