          "path": "cli/pyproject.toml",
          "pattern": "^version = \"[^\"]+\"$",
          "replacement": "version = \"{version}\""
        },
        {
          "path": "cli/src/opamp_cli/version.json",
          "pattern": "  \"effective_label\": \"[^\"]+\",",
          "replacement": "  \"effective_label\": \"{version}\",",
          "count": 1
        },
        {
          "path": "cli/src/opamp_cli/version.json",
          "pattern": "  \"version\": \"[^\"]+\"",
          "replacement": "  \"version\": \"{version}\"",
          "count": 1
        }
      ]
    },
