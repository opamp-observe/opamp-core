      "data_type": "integer",
      "validation_rule": {
        "kind": "range"
      },
      "default": 300
    },
    {
      "name": "tags_enabled",
      "required": true,
      "description": "Specifies whether to attach EC2 instance tags. The EC2 instance must have the instance-metadata-tags option enabled, which is disabled by default.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/aws-metadata#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "tags_exclude",
      "required": true,
      "description": "Defines a list of specific EC2 tag keys not to inject into the logs. Tag keys must be comma-separated (,). Tags not included in this list will be injected into the logs. If both tags_include and tags_exclude are specified, the configuration is invalid and the plugin fails. Example: Name,tag1,tag2",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/aws-metadata#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "tags_include",
      "required": true,
      "description": "Defines a list of specific EC2 tag keys to inject into the logs. Tag keys must be comma-separated (,). Tags not included in this list will be ignored. Example: Name,tag1,tag2.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/filters/aws-metadata#configuration-parameters",
      "data_type": "list",
      "validation_rule": {
        "kind": "list",
        "delimiter": ","
      }
    },
    {
      "name": "vpc_id",
      "required": false,
      "description": "The VPC ID for the current EC2 instance.",
