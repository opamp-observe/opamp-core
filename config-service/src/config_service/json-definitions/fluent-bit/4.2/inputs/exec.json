      "data_type": "integer",
      "validation_rule": {
        "kind": "range"
      },
      "default": 0
    },
    {
      "name": "interval_sec",
      "required": false,
      "description": "Polling interval (seconds).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/exec#configuration-parameters",
