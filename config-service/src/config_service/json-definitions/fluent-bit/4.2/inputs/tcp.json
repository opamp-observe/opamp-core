{
  "title": "TCP",
  "doc_url": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp",
  "fields": [
    {
      "name": "buffer_size",
      "required": false,
      "description": "Specify the maximum buffer size in KB to receive a JSON message. If not set, the default is the value of chunk_size.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "size"
      },
      "default": "chunk_size"
    },
    {
      "name": "chunk_size",
      "required": true,
      "description": "The default buffer to store the incoming JSON messages. It doesn't allocate the maximum memory allowed; instead it allocates memory when required. The rounds of allocations are set by chunk_size. If not set, chunk_size is equal to 32 (32 KB).",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
      "data_type": "integer",
      "validation_rule": {
        "kind": "range"
      },
      "default": 32
    },
    {
      "name": "format",
      "required": false,
      "description": "Specify the expected payload format. Supported values: json and none. When set to json it expects JSON maps. When set to none, every record splits using the defined separator.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
      "data_type": "string",
      "validation_rule": {
        "kind": "enum",
        "values": [
          "none",
          "JSON"
        ]
      },
      "default": "json",
      "enum_options": [
        "none",
        "JSON"
      ]
    },
    {
      "name": "listen",
      "required": false,
      "description": "Listener network interface.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
      "data_type": "string",
      "validation_rule": null,
      "default": "0.0.0.0"
    },
    {
      "name": "port",
      "required": false,
      "description": "TCP port to listen for connections.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
      "data_type": "integer",
      "validation_rule": {
        "kind": "range"
      },
      "default": 5170
    },
    {
      "name": "separator",
      "required": false,
      "description": "When format is set to none, Fluent Bit needs a separator string to split the records.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
      "data_type": "string",
      "validation_rule": null,
      "default": "LF or 0x10 (break line)"
    },
    {
      "name": "source_address_key",
      "required": false,
      "description": "Specify the key to inject the source address.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
      "data_type": "string",
      "validation_rule": null
    },
    {
      "name": "threaded",
      "required": false,
      "description": "Indicates whether to run this input in its own thread.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
      "data_type": "boolean",
      "validation_rule": {
        "kind": "boolean"
      },
      "default": false
    },
    {
      "name": "tag",
      "required": true,
      "description": "Tag assigned to records emitted by this input plugin.",
      "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/router",
      "data_type": "string",
      "validation_rule": null
    }
  ],
  "extraction": {
    "status": "ok",
    "reference": "https://docs.fluentbit.io/manual/4.2/data-pipeline/inputs/tcp#configuration-parameters",
    "table_header": [
      "Key",
      "Description",
      "Default"
    ]
  },
  "description": "Fluent Bit input plugin: TCP."
}
